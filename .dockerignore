# ---------------------------------------------------------------------------
# Docker build context for the Taiga MCP server.
# Goal: keep build artifacts, secrets and certificates out of the image.
# ---------------------------------------------------------------------------

# Build output and IDE files
**/bin/
**/obj/
.vs/
.vscode/
.idea/

# Tests and coverage (not needed in the image)
tests/
TestResults/
*.trx
*.coverage
*.coveragexml

# Secrets and local settings: mounted at startup, never baked in
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.secrets.json
.env

# Certificates: mounted at startup
certs/
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer

# Miscellaneous
.git/
.gitignore
*.md
Dockerfile
.dockerignore
docker-compose*.yml
